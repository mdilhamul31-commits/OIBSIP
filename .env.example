# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MongoDB connection string
MONGODB_URI="mongodb+srv://user:pass@cluster.mongodb.net/pizza_delivery?retryWrites=true&w=majority"

# JWT Secret for authentication
JWT_SECRET="supersecret_jwt_key_here_change_in_production"

# Razorpay Test Credentials (TEST MODE ONLY)
RAZORPAY_KEY_ID="rzp_test_xxxxxx"
RAZORPAY_KEY_SECRET="secret_xxxxxx"

# Email Configuration (Nodemailer)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="your-app-password"

# Admin configuration
ADMIN_EMAIL="admin@pizza.com"
ADMIN_PASSWORD="admin_secure_password"

# Frontend URL (usually same as APP_URL in production, or http://localhost:3000 locally)
FRONTEND_URL="http://localhost:3000"
